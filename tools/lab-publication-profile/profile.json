{
  "schemaVersion": 1,
  "name": "@examplicity/lab-publication-profile",
  "version": "1.0.0",
  "owner": "cambridge-labs live-site repository",
  "artifact": {
    "format": "single-html",
    "runtimeNetworkDependenciesAllowed": false
  },
  "layout": {
    "desktopRailMaxPx": 1200,
    "desktopGutterMinPx": 28,
    "mobileGutterPx": 18,
    "manifestHeaderUsesFullRail": true,
    "compactWorkspaceMaxPx": 820,
    "applicationViewport": {
      "width": 1280,
      "height": 720
    },
    "standaloneViewports": [
      {
        "width": 1440,
        "height": 1000
      },
      {
        "width": 1366,
        "height": 768
      }
    ],
    "responsiveWidthsPx": [
      1200,
      900,
      390
    ],
    "pageHorizontalOverflowAllowed": false
  },
  "experience": {
    "freshProblemIncompleteAtEveryAssistanceLevel": true,
    "assistanceMayRemoveWorkingButNotLearnerAction": true
  }
}
