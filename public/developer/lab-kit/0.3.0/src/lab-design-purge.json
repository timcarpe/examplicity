{
  "description": "Remix primitives retained when packaging shared design CSS. Standard tokens preserve compatibility roots and transient states; component patterns preserve their descendants. Lab-specific adapters still require matching source content.",
  "compatibility": "The :is and :where tokens preserve compound pseudo-class rules in PurgeCSS 8, including field focus. Their unused inner selectors are still removed. Dataset attribute names are extracted from embedded scripts by the packager.",
  "standard": [":is", ":where", "lab-adopt-v3", "lab-settings-adopt", "button", "input", "select", "textarea", "option", "optgroup", "label", "fieldset", "legend", "form", "active", "selected", "current", "needed", "good", "bad", "correct", "incorrect", "complete", "completed", "locked", "ready", "pending", "disabled", "dragging", "is-open", "open", "error", "invalid"],
  "components": [
    "^lab-(?:action|reset-action|reset-host)$",
    "^lab-(?:toggle|working-toggle|mode-toggle|working-label|settings-path|setting-old-label)$",
    "^lab-(?:activity-bar|model-tools|tool-bar|tool-buttons|secondary-bar)$",
    "^lab-(?:field-control|menu-field|menu-select)$",
    "^lab-(?:work-card|evidence-card|sidebar)$",
    "^lab-(?:math-surface|chip|chip-row)$",
    "^lab-(?:claim-context|claim-context-title|working-context|working-readout|working-requirement)$",
    "^lab-(?:checkpoint|checkpoints|checkpoint-detail)$",
    "^lab-(?:intro-card|intro-target|guide-target|sequence-target|is-dragging|dialog-move)$",
    "^next-card$",
    "^lab-(?:svg-value-surface|boundary-[\\w-]+|value-grip|cycle-progress)$"
  ],
  "dynamicAttributes": ["data-lab-attention", "data-state", "data-status", "data-lab-state", "data-lab-value", "aria-selected", "aria-pressed", "aria-expanded", "aria-disabled", "aria-invalid", "aria-checked", "role", "type"]
}
